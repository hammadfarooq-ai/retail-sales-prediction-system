# Copy to .env and change the secrets. .env is git-ignored.

# --- PostgreSQL (used by docker compose and by the backend) ---
POSTGRES_USER=retail
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=retail_sales
# Host/port the backend uses when run on your machine (compose postgres publishes 55432).
# Inside compose the backend is automatically pointed at postgres:5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
# Host port that compose publishes PostgreSQL on (55432 avoids clashing with a local install).
POSTGRES_HOST_PORT=55432
# Optional full URL; overrides the individual POSTGRES_* values when set.
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname

# --- Use your own PostgreSQL (e.g. a database named RetailDB) ---
# For the API run on your machine (make api / make seed):
# DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/RetailDB
# For docker compose (same database, reached from the container via the host):
# COMPOSE_DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@host.docker.internal:5432/RetailDB
# If COMPOSE_DATABASE_URL is empty, use the bundled database: docker compose --profile bundled-db up --build

# --- Backend ---
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
MODEL_ARTIFACTS_DIR=./ml/artifacts
PROCESSED_DATA_DIR=./data/processed
HISTORY_DAYS_IN_DB=180
MAX_FORECAST_HORIZON_DAYS=28
MAX_BATCH_SIZE=500
BACKEND_HOST_PORT=8000

# --- Frontend ---
FRONTEND_HOST_PORT=3000
# Only for local `npm run dev`: where the Vite dev server proxies /api
VITE_DEV_PROXY_TARGET=http://localhost:8000
